# Identity used by packaging/build-msix.ps1.
#
# Copy these three lines into a .env file at the repository root (gitignored) or
# export them in the shell before building. The values come from Partner Center:
# your product -> Product management -> Product identity. They are public data -
# every installed package exposes them - but they stay out of the repository so a
# fork builds under its own publisher.
MSIX_IDENTITY_NAME=
MSIX_PUBLISHER=
MSIX_PUBLISHER_DISPLAY_NAME=
