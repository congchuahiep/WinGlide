<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the MSIX package. `packaging/build-msix.ps1` replaces the
  {{PLACEHOLDERS}} and writes the result next to the staged payload.

  The identity values are not committed: the build reads them from the
  environment (MSIX_IDENTITY_NAME, MSIX_PUBLISHER, MSIX_PUBLISHER_DISPLAY_NAME),
  falling back to a local .env file. They are public data - every installed
  package exposes them - but keeping them out of the template means a fork
  builds under its own publisher instead of colliding with this one.

  `resources.pri` is rebuilt by `build-msix.ps1`: the file names of the
  `Assets/` logos are not enough on their own, Windows resolves the
  `altform-unplated` variants through the index. The build merges an
  Assets-only index into the Windows App SDK's own `resources.pri` so WinUI
  resource lookup keeps working. Plain strings are used instead of
  `ms-resource:`.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>WinGlide</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Description>Taskbar and virtual desktop navigation for Windows 11</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.22000.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="WinGlide"
      Executable="WinGlide.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="WinGlide"
        Description="Taskbar and virtual desktop navigation for Windows 11"
        BackgroundColor="#163E8F"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="WinGlide.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask
            TaskId="WinGlideStartup"
            Enabled="false"
            DisplayName="WinGlide" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
